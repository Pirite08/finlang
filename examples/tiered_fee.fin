// 이 예제는 해당 구간의 요율을 전체 원금에 한 번 적용합니다.
let calculate_fee = fn(principal) {
    let thresholds = [money("KRW", 1000000), money("KRW", 5000000)];
    let rates = [0.01, 0.0075, 0.005];
    let index = lower_bound(thresholds, principal);

    // 경계와 정확히 같으면 다음 구간입니다.
    // index가 끝에 있으면 && 오른쪽의 인덱싱을 건너뜁니다.
    let tier = if (index < len(thresholds) && thresholds[index] == principal) {
        index + 1
    } else {
        index
    };
    let rate_for_tier = rates[tier];
    let fee = settle(principal * rate_for_tier, 0, "HALF_EVEN");
    return [rate_for_tier, fee];
};

// 두 경계의 0.01원 아래, 경계값, 0.01원 위를 계산합니다.
for principal in [999999.99, 1000000, 1000000.01, 4999999.99, 5000000, 5000000.01] {
    print(calculate_fee(money("KRW", principal)));
}
